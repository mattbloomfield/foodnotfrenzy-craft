<header class="bg-espresso print:hidden">
    <div class="container mx-auto px-4 py-5">
        <nav class="flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-white font-serif">{{ siteName }}</a>

            <div class="flex items-center gap-5">
                <!-- Mobile Menu Button (hamburger) -->
                <button popovertarget="mobile-menu" class="md:hidden flex items-center" aria-label="Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <!-- Desktop Navigation -->
                <ul class="hidden md:flex items-center space-x-8">
                    <li><a href="/about" class="text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">About</a></li>
                    <li><a href="/categories" class="text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">Categories</a></li>
                    <li><a href="/feeling-lucky" class="text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">Feeling Lucky</a></li>
                    <li><a href="/search" class="text-shell-ink hover:text-white transition duration-200 flex items-center" aria-label="Search">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </a></li>
                </ul>

                <!-- Theme picker toggle -->
                <button popovertarget="theme-menu" class="flex items-center text-shell-ink hover:text-white transition duration-200" aria-label="Theme &amp; colors" title="Theme &amp; colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 1 0-18c4.97 0 9 3.58 9 8 0 2.76-2.24 5-5 5h-1.77c-.83 0-1.5.67-1.5 1.5 0 .38.14.73.39 1 .24.28.38.63.38 1 0 .83-.67 1.5-1.5 1.5Z" />
                        <circle cx="7.5" cy="11.5" r="1" fill="currentColor" />
                        <circle cx="10.5" cy="7.5" r="1" fill="currentColor" />
                        <circle cx="14.5" cy="7.5" r="1" fill="currentColor" />
                        <circle cx="17" cy="11" r="1" fill="currentColor" />
                    </svg>
                </button>
            </div>
        </nav>

        <!-- Mobile Navigation Menu (Popover API) -->
        <div id="mobile-menu" popover class="md:hidden mt-4 pb-4 border-t border-white/10 pt-4 bg-espresso inset-auto top-16 left-0 right-0 px-4">
            <ul class="flex flex-col space-y-4">
                <li><a href="/about" class="block text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">About</a></li>
                <li><a href="/categories" class="block text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">Categories</a></li>
                <li><a href="/feeling-lucky" class="block text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">Feeling Lucky</a></li>
                <li><a href="/search" class="block text-sm uppercase tracking-widest text-shell-ink hover:text-white transition duration-200">Search</a></li>
            </ul>
        </div>

        <!-- Theme picker panel (Popover API) -->
        {% set palettes = [
            { handle: 'hearth', label: 'Hearth', colors: ['#5C4232', '#BC6248', '#71906B'] },
            { handle: 'market', label: 'Market', colors: ['#2F4A34', '#BC4430', '#9A7D1E'] },
            { handle: 'berry',  label: 'Berry',  colors: ['#4A2B45', '#AE3A5B', '#82688F'] },
            { handle: 'citrus', label: 'Citrus', colors: ['#4A4526', '#C05F1D', '#93832A'] },
            { handle: 'tide',   label: 'Tide',   colors: ['#1F4E52', '#B26749', '#5F8A93'] },
        ] %}
        <div id="theme-menu" popover class="bg-cream text-gray-800 rounded-xl shadow-xl p-5 w-72" data-behavior="themePicker">
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-3">Color palette</p>
            <div class="grid grid-cols-5 gap-2 mb-5">
                {% for p in palettes %}
                    <button type="button" data-set-palette="{{ p.handle }}" title="{{ p.label }}"
                            class="group/swatch flex flex-col items-center gap-1.5 rounded-lg p-1.5 border-2 border-transparent transition duration-150">
                        <span class="flex h-8 w-8 rounded-full overflow-hidden ring-1 ring-black/10 rotate-45">
                            {% for c in p.colors %}<span class="w-1/3 h-full" style="background-color: {{ c }}"></span>{% endfor %}
                        </span>
                        <span class="text-[10px] uppercase tracking-wide text-gray-600">{{ p.label }}</span>
                    </button>
                {% endfor %}
            </div>

            <p class="text-xs uppercase tracking-widest text-gray-500 mb-3">Appearance</p>
            <div class="grid grid-cols-3 rounded-full border border-stone overflow-hidden text-sm">
                <button type="button" data-set-scheme="light" class="py-1.5 transition duration-150">Light</button>
                <button type="button" data-set-scheme="auto" class="py-1.5 border-x border-stone transition duration-150">Auto</button>
                <button type="button" data-set-scheme="dark" class="py-1.5 transition duration-150">Dark</button>
            </div>
        </div>
    </div>
</header>
