{
  "minimum-stability": "beta",
  "prefer-stable": true,
  "require": {
    "craftcms/ckeditor": "6.0.0-beta.1",
    "craftcms/cms": "6.0.0-beta.1",
    "craftcms/yii2-adapter": "6.0.0-beta.1"
  },
  "require-dev": {
    "craftcms/generator": "3.x-dev"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.0"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan craft:setup:publish --ansi"
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ],
  "autoload": {
    "psr-4": {
      "MattBloomfield\\RecipeHelper\\": "modules/recipe-helper/"
    }
  }
}
