# Read about configuration, here:
# https://craftcms.com/docs/6.x/configure.html

APP_NAME="Food Not Frenzy"
APP_ENV=staging
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=
PRIMARY_SITE_URL=

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=staging

# Database connection settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
DB_SCHEMA=public
DB_TABLE_PREFIX=

# General settings
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=true

CACHE_STORE=file
SESSION_DRIVER=file
