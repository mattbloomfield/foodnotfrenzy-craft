# Read about configuration, here:
# https://craftcms.com/docs/6.x/configure.html

APP_NAME="Food Not Frenzy"
APP_ENV=staging
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=
PRIMARY_SITE_URL=

# Database connection settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
DB_SCHEMA=public
DB_TABLE_PREFIX=

# General settings
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=true

CACHE_STORE=file
SESSION_DRIVER=file

# Email. Defaults to sendmail (MAIL_SENDMAIL_PATH, default: PHP's sendmail_path
# or "/usr/sbin/sendmail -bs"). For SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
