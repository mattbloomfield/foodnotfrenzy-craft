{% set large = large|default(false) %}
<a href="{{ href }}" class="group">
	<article class="bg-cream overflow-hidden h-full">
		{# Polaroid-style inset image #}
		<div class="p-2.5 pb-0">
			<div class="overflow-hidden rounded-[0.65rem] {{ large ? 'aspect-[2/1]' : 'aspect-[4/3]' }}">
				{% set card = {
                    mode: 'crop',
                    width: large ? 736 : 352,
                    height: large ? 368 : 264,
                    quality: 75,
                    position: 'center-center'
                } %}
				{% if image is not null %}
					{# Craft 6 beta: getWidth/getHeight(transform) throw (500) when the image driver
					   can't transform the file type; fall back to the transform's own size. #}
					{% set transformable = image.supportsImageEditor %}
					<img src="{{ image.getUrl(card) }}" width="{{ transformable ? image.getWidth(card) : card.width }}" height="{{ transformable ? image.getHeight(card) : card.height }}" alt="{{ title }}" loading="lazy" class="object-cover w-full h-full group-hover:scale-[1.03] transition-transform duration-500 ease-out">
				{% else %}
					<img src="/dist/placeholder.jpg" alt="Placeholder Image" width="352" height="264" loading="lazy" class="object-cover w-full h-full group-hover:scale-[1.03] transition-transform duration-500 ease-out">
				{% endif %}
			</div>
		</div>

		<div class="px-4 pt-3 pb-4">
			<h2 class="{{ large ? 'text-2xl' : 'text-lg' }} font-bold font-serif text-warm-brown leading-snug group-hover:text-clay transition duration-200">{{ title }}</h2>

			{% if description %}
				<p class="mt-1.5 text-sm text-gray-600 line-clamp-2 leading-relaxed">{{ description }}</p>
			{% endif %}

			{% if categories|length %}
				<p class="mt-2.5 text-xs uppercase tracking-widest text-sage font-medium">
					{% for category in categories %}{{ category.title }}{% if not loop.last %} <span class="text-clay">·</span> {% endif %}{% endfor %}
				</p>
			{% endif %}
			{% if date is defined %}
				<p class="mt-2 text-gray-400 text-[11px] uppercase tracking-wide">{{ date|date('M j, Y') }}</p>
			{% endif %}
		</div>
	</article>
</a>
